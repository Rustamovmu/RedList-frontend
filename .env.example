# Server-side URL of the backend (never exposed to the browser)
API_INTERNAL_URL=http://localhost:4000
# Must equal REVALIDATE_SECRET in the backend .env (generate one: openssl rand -hex 32)
REVALIDATE_SECRET=change-me-long-random-string
# Public canonical origin (sitemap and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a contact link shown on /about and /privacy (a project URL or role address, not a personal one)
# NEXT_PUBLIC_CONTACT_URL=https://example.org/contact
